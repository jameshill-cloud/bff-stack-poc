<form method="POST" action="/example-island">
  <div id="example-island-fallback" class="govuk-panel">
    <h2 class="govuk-heading-m">JavaScript disabled: SSR fallback</h2>
    <p class="govuk-body">Initial count: <strong>{{ initialCount }}</strong></p>
    <p class="govuk-body">Current: {{ counterValue }}</p>
    <div style="display:inline-flex;gap:8px">
      <button
        id="decrement-btn"
        class="govuk-button"
        type="submit"
        name="action"
        value="decrement"
      >
        Decrement
      </button>
      <button
        id="increment-btn"
        class="govuk-button"
        type="submit"
        name="action"
        value="increment"
      >
        Increment
      </button>
    </div>
  </div>

  {# React enhancement mount point #}
  {{ islandMount | safe }}

  {# Canonical submitted values #}
  <input type="hidden" name="counterValue" value="{{ counterValue }}" />
</form>

{% extends "layouts/base.njk" %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Small Claims Portal</h1>

    <p class="govuk-body">
      This is the ALPHA phase of a new service
    </p>

    <h2 class="govuk-heading-m">React SSR Example</h2>
    <div class="govuk-inset-text">
      The content below is rendered by React on the server and sent as HTML:
    </div>

    {{ serverComponentHtml | safe }}

    <h2 class="govuk-heading-m">Interactive Island Example</h2>
    <p class="govuk-body">
      The component below is a React island that hydrates interactively on the client:
    </p>

    {% set initialCount = initialCount | default(0) %}
    {% set counterValue = counterValue | default(0) %}

    {% include "partials/example-island.njk" %}

    <h2 class="govuk-heading-m">Learn More</h2>
    <ul class="govuk-list govuk-list--bullet">
      <li>Progressive enhancement with server-first rendering</li>
      <li>React for server-side HTML generation</li>
      <li>React islands for interactive components</li>
      <li>GOV.UK Frontend styling and components</li>
      <li>Fully functional without JavaScript</li>
    </ul>
  </div>
</div>
{% endblock %}


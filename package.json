{
  "name": "agents-fullstack-phase1-bootstrap-setup",
  "version": "1.0.0",
  "description": "NestJS + React PoC for modern SSR-first GOV.UK technology stack",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run copy-assets && nest build && ts-node scripts/build-islands.ts",
    "build:islands": "ts-node scripts/build-islands.ts",
    "build:islands:watch": "ts-node scripts/build-islands.ts --watch",
    "copy-assets": "ts-node scripts/copy-assets.ts",
    "start": "node dist/main",
    "dev": "concurrently --kill-others-on-fail false \"npm run copy-assets\" \"npm run build:islands:watch\" \"nest start --watch\" \"npm run mock-api\"",
    "mock-api": "json-server --watch mock-api/db.json --port 3001 --routes mock-api/routes.json",
    "test": "vitest",
    "lint": "eslint \"{src,client}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,client,views}/**/*.{ts,tsx,njk}\""
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "govuk-frontend": "^6.2.0",
    "nunjucks": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/govuk-frontend": "^5.11.0",
    "@types/node": "^20.19.41",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "json-server": "0.17.4",
    "prettier": "^3.1.1",
    "prettier-plugin-jinja-template": "^2.2.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  }
}
